{
  "name": "fleet-management-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fleet/web",
    "build": "npm run build -w @fleet/web",
    "start": "npm run start -w @fleet/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check:secrets && npm run typecheck && npm run lint && npm run test",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "engines": {
    "node": ">=20.9"
  }
}
