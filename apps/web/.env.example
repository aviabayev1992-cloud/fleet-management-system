# Supabase connection settings (public values only).
# Copy this file to ".env.local" in the same folder and fill in the values.
# ".env.local" is ignored by Git and is never uploaded.
#
# Where to find them: Supabase dashboard > your project > "Connect" button
# (or Project Settings > API Keys / Data API).
#
# NEVER put the Secret key (sb_secret_...) or the service_role key here.

# Project URL, for example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key, starts with: sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
